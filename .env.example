# Sitenin kendi adresi. YALNIZCA canlıda https://servomold.com.tr yazın:
# bu değer tam eşleşmezse site arama motorlarına kapalı kalır (noindex),
# böylece önizleme kopyaları canlı siteyle yarışmaz.
NEXT_PUBLIC_SITE_URL=

# Teklif formu e-postası (SMTP). Boşsa form "e-postayla yazın" uyarısı gösterir.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Gönderen adresi (boşsa SMTP_USER kullanılır)
SMTP_FROM=
# Taleplerin gideceği adres
TEKLIF_ALICI=info@servomold.com.tr

# Arama motoru doğrulama (isteğe bağlı)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
